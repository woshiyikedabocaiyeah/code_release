knitr::opts_chunk$set(echo = TRUE)
path <- "."
csv_files <- list.files(
path = path,
pattern = "\\.csv$",
full.names = TRUE
)
for (file in csv_files) {
obj_name <- tools::file_path_sans_ext(basename(file))
assign(obj_name, read.csv(file), envir = .GlobalEnv)
}
feature_phys_surprise_scores <- feature_phys_surprise_scores %>% select(video_name,physical_z)
library(tidyverse)
View(all_cat_cat)
